+// group's original GEMM shape and arithmetic, including its point ordering.
+class TargetTransport {
+ public:
+  explicit TargetTransport(const ChangeEvent& event) : groups_(event.correction_groups) {
+    if (!groups_.empty()) group_ids_ = event.correction_group_id.cpu().contiguous();
+  }
+
+  GaussianAttrState apply(GaussianAttrState target, const torch::Tensor& indices) const {
+    if (groups_.empty() || indices.numel() == 0) return target;
+    torch::NoGradGuard no_grad;
+    const auto host_indices = indices.cpu().contiguous();
+    const auto* ids = host_indices.data_ptr<int64_t>();
+    const auto* group_ids = group_ids_.data_ptr<int64_t>();
+    std::vector<std::vector<int64_t>> local(groups_.size());
+    for (int64_t i = 0; i < indices.numel(); ++i) {
+      const auto g = group_ids[ids[i]];
+      if (g >= 0) local[g].push_back(i);
+    }
+    std::vector<int64_t> packed;
+    packed.reserve(indices.numel());
+    for (const auto& group : local) packed.insert(packed.end(), group.begin(), group.end());
+    if (packed.empty()) return target;
