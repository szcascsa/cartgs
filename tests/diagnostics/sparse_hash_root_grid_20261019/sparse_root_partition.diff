+      if (count >= kTargetOccupiedRoots) { result.crossing_bracketed = true; break; }
+    }
+  } else {
+    low = std::max(current * .5, min_h); high = std::min(current * 2, max_h);
+    evaluate(low); evaluate(high); result.crossing_bracketed = true;
+  }
