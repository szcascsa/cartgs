+struct SpatialArgs {
+  float *grad[3],*output[3];
+  const float *activation[3],*weight[3];
+};
+__global__ void spatialInputVjp(SpatialArgs a,int n) {
+  // 24 points x 10 output components occupy 240/256 lanes. Transposed,
+  // padded shared storage avoids bank conflicts during ordered dot products.
+  constexpr int points=24,stride=points*3+1;
+  __shared__ float tile[32*stride];
+  int base=blockIdx.x*points;
+  for(int i=threadIdx.x;i<points*32;i+=blockDim.x) {
+    int point=i/32,k=i%32,row=base+point;
+    if(row<n)for(int b=0;b<3;++b) {
+      float value=a.activation[b][row*32+k]<=0?0:a.grad[b][row*32+k];
+      a.grad[b][row*32+k]=value;tile[k*stride+point*3+b]=value;
+    }
+  }
+  __syncthreads();
+  int point=threadIdx.x/10,component=threadIdx.x%10,row=base+point;
+  if(point<points && row<n) {
+    int branch=component<3?0:(component<7?1:2),dim=branch==1?4:3;
+    int column=component-(branch==0?0:branch==1?3:7);
+    const float* weight=a.weight[branch]+column;
+    float sum=0;
+    #pragma unroll
+    for(int k=0;k<32;++k)sum=fmaf(tile[k*stride+point*3+branch],weight[k*dim],sum);
+    a.output[branch][row*dim+column]=sum;
+  }
+}
+void combinedSpatial(const std::vector<torch::Tensor>& x,const std::vector<torch::Tensor>& p,
+    const std::vector<torch::Tensor>& h,std::vector<torch::Tensor>& grads,
+    std::vector<torch::Tensor>& result,bool strict) {
+  int n=x[0].size(0);SpatialArgs args{};
+  for(int b=0;b<3;++b) {
+    result[b]=torch::empty_like(x[b]);args.grad[b]=grads[b].data_ptr<float>();
+    args.output[b]=result[b].data_ptr<float>();args.activation[b]=h[b*2].data_ptr<float>();
+    args.weight[b]=p[b*4].data_ptr<float>();
+  }
+  if(n)spatialInputVjp<<<(n+23)/24,256,0,stream()>>>(args,n);
+  for(int b=0;b<3;++b) {
+    result[4+b*4+1]=biasGradient(grads[b],strict);result[4+b*4]=torch::empty_like(p[b*4]);
+    if(n)gemm('n','t',x[b].size(1),32,n,1.f,x[b].data_ptr<float>(),x[b].size(1),
+        grads[b].data_ptr<float>(),32,0.f,result[4+b*4].data_ptr<float>(),x[b].size(1));
+    else result[4+b*4].zero_();
+  }
+  grads.clear();
+}
 }  // namespace
 
