+    int k=j%3+1,l=(j+1)%3+1;
+    float cross=__fmaf_rn(a[k],b[l],-__fmul_rn(a[l],b[k]));
+    out[i*4+j]=__fadd_rn(__fadd_rn(__fmul_rn(a[0],b[j]),__fmul_rn(b[0],a[j])),cross);
