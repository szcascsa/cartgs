get_filename_component(MYCARTGS_STUDY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(XNNPACK_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(XNNPACK_BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(XNNPACK_BUILD_ALL_MICROKERNELS OFF CACHE BOOL "" FORCE)
set(XNNPACK_LIBRARY_TYPE static CACHE STRING "" FORCE)
set(XNNPACK_ENABLE_KLEIDIAI OFF CACHE BOOL "" FORCE)
foreach(feature ARM_BF16 ARM_I8MM ARM_SVE2 ARM_SME ARM_SME2 ARM_SME_ACLE)
    set(XNNPACK_ENABLE_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CPUINFO_SOURCE_DIR "${MYCARTGS_STUDY_ROOT}/third_party/cpuinfo" CACHE PATH "" FORCE)
set(PTHREADPOOL_SOURCE_DIR "${MYCARTGS_STUDY_ROOT}/third_party/pthreadpool" CACHE PATH "" FORCE)
set(FXDIV_SOURCE_DIR "${MYCARTGS_STUDY_ROOT}/third_party/FXdiv" CACHE PATH "" FORCE)
set(PTHREADPOOL_LIBRARY_TYPE static CACHE STRING "" FORCE)
set(CPUINFO_LIBRARY_TYPE static CACHE STRING "" FORCE)
set(FXDIV_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(FXDIV_BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
if(NOT TARGET XNNPACK)
    add_subdirectory("${MYCARTGS_STUDY_ROOT}/third_party/XNNPACK" "${CMAKE_BINARY_DIR}/xnnpack" EXCLUDE_FROM_ALL)
    # OpenXR's warning-as-error policy is not an upstream XNNPACK build requirement.
    get_property(xnn_targets DIRECTORY "${MYCARTGS_STUDY_ROOT}/third_party/XNNPACK" PROPERTY BUILDSYSTEM_TARGETS)
    list(APPEND xnn_targets cpuinfo pthreadpool)
    foreach(xnn_target IN LISTS xnn_targets)
        get_target_property(xnn_type ${xnn_target} TYPE)
        if(NOT xnn_type STREQUAL "INTERFACE_LIBRARY" AND NOT xnn_type STREQUAL "UTILITY")
            target_compile_options(${xnn_target} PRIVATE -Wno-error
                -Wno-error=unused-parameter -Wno-error=unused-argument -Wno-error=missing-prototypes
                -Wno-error=implicit-fallthrough -Wno-error=undef -Wno-error=tautological-type-limit-compare
                -Wno-error=missing-braces -Wno-error=unreachable-code -Wno-error=c++20-extensions)
        endif()
    endforeach()
endif()
